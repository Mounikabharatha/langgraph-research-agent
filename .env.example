# ---- Which LLM provider to use: "google" or "openai" ----
LLM_PROVIDER=google

# ---- Google Gemini (default) ----
# Free tier, no credit card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here
# Free-tier quota is PER MODEL PER DAY, so switching models resets your budget.
# gemini-3.1-flash-lite  - biggest free allowance, good enough for this agent
# gemini-3.5-flash       - better reasoning, smaller free allowance
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- OpenAI (only if LLM_PROVIDER=openai) ----
# NOTE: the API is billed separately from ChatGPT Plus. A Plus subscription
# does NOT give you API credit - load it at platform.openai.com billing.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---- Required for web search ----
# Free tier at https://tavily.com (1000 searches/month)
TAVILY_API_KEY=tvly-...

# ---- Long-term memory (remembers finished research between runs) ----
# On by default; it reuses GOOGLE_API_KEY for embeddings.
# MEMORY_ENABLED=true
# MEMORY_DB=memory.db
# EMBED_MODEL=models/gemini-embedding-001
#
# Cosine similarity runs high even for unrelated text: measured 0.874 for a
# genuine match vs 0.697 for an unrelated topic. This floor is what keeps
# every old report from counting as relevant.
# MEMORY_MIN_RELEVANCE=0.80

# ---- Optional: tracing / observability (LangSmith) ----
# Free tier at https://smith.langchain.com - see every node call, its prompt,
# its tokens and its latency. Tracing is enabled purely by these variables;
# there is no "invoke_with_observability()" function, whatever the roadmap
# PDF says.
#
# langsmith reads LANGSMITH_* first and falls back to LANGCHAIN_*.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=research-agent
