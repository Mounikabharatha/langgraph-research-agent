# ---- Required: one LLM provider ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---- Required for real web search ----
# Free tier at https://tavily.com (1000 searches/month)
TAVILY_API_KEY=tvly-...

# ---- Optional: tracing / observability (LangSmith) ----
# This is how you actually enable tracing. There is no
# "invoke_with_observability()" function, whatever the roadmap PDF says.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=research-agent
